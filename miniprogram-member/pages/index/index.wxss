.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shift-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.notice {
  margin: 16rpx 0 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.notice.holiday {
  background: #ecfdf5;
  color: #047857;
}

.notice.makeup {
  background: #fff7ed;
  color: #9a3412;
}

/* ========== v7.3 月度统计 + 班次评价 四宫格 ========== */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-cell {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #111827;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  margin-left: 6rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.stat-shift {
  border-top: 6rpx solid #8B1A1A;
}

.stat-shift .stat-value {
  color: #8B1A1A;
}

.stat-hours {
  border-top: 6rpx solid #2563eb;
}

.stat-hours .stat-value {
  color: #2563eb;
}

.stat-pay {
  border-top: 6rpx solid #d97706;
}

.stat-pay .stat-value {
  color: #d97706;
}

/* 班次评价格 */
.stat-rate {
  border-top: 6rpx solid #7c3aed;
}

.stat-rate .stat-value {
  color: #7c3aed;
}

.stat-rate-num {
  font-size: 40rpx;
  margin-top: 6rpx;
}

.stat-rate-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.stat-rate-head .stat-label {
  margin-bottom: 0;
  line-height: 1.3;
}

.rate-reset {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  border: 1rpx solid #ddd6fe;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.6;
}

.stars {
  display: flex;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.star {
  font-size: 40rpx;
  line-height: 1;
  color: #e5e7eb;
}

.star.on {
  color: #f59e0b;
}

.stat-rate-avg {
  color: #7c3aed;
  font-weight: 600;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

/* ========== v7.6 补签退 / 工作补报 ========== */
.extra-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.extra-actions .btn {
  font-size: 26rpx;
  font-weight: 600;
}

.extra-tip {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-box {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7f1d1d;
  margin-bottom: 10rpx;
}

.modal-tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 8rpx;
}

.pill.completed {
  background: #dcfce7;
  color: #166534;
}

.pill.in_progress {
  background: #fef3c7;
  color: #92400e;
}

.pill.pending {
  background: #fee2e2;
  color: #8B1A1A;
}
