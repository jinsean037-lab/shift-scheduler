.profile-header {
  align-items: flex-start;
}

.profile-header .title {
  max-width: 460rpx;
  word-break: break-all;
}

.subscribe-card {
  align-items: flex-start;
  gap: 20rpx;
}

.subscribe-text {
  flex: 1;
  min-width: 0;
}

.subscribe-text .card-title {
  margin-bottom: 8rpx;
}

.subscribe-card .muted {
  line-height: 1.55;
}

.arrow {
  color: #cbd5e1;
  font-size: 44rpx;
  line-height: 1;
}
