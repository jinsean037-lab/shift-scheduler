/* ========== 数据概览四宫格 ========== */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-cell {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
  min-height: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #111827;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  margin-left: 6rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.stat-shift {
  border-top: 6rpx solid #8B1A1A;
}

.stat-shift .stat-value {
  color: #8B1A1A;
}

.stat-hours {
  border-top: 6rpx solid #2563eb;
}

.stat-hours .stat-value {
  color: #2563eb;
}

.stat-pay {
  border-top: 6rpx solid #d97706;
}

.stat-pay .stat-value {
  color: #d97706;
}

.stat-rate {
  border-top: 6rpx solid #7c3aed;
}

.stat-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

/* ========== 班次评价 ========== */
.rate-reset {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border: 1rpx solid #ddd6fe;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 600;
}

.emoji-picker {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.emoji-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 4rpx;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f3;
  background: #fbfbfc;
}

.emoji-item.on {
  background: #fff7ed;
  border-color: #fdba74;
  box-shadow: 0 6rpx 16rpx rgba(217, 119, 6, 0.12);
}

.emoji-face {
  font-size: 44rpx;
  line-height: 1.15;
  opacity: 0.4;
}

.emoji-item.on .emoji-face {
  opacity: 1;
}

.emoji-text {
  font-size: 19rpx;
  color: #9ca3af;
  white-space: nowrap;
}

.emoji-item.on .emoji-text {
  color: #b45309;
  font-weight: 700;
}

.rate-current {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f9fafb;
  border: 1rpx solid #eef0f3;
}

.rate-current-emoji {
  font-size: 38rpx;
  line-height: 1;
}

.rate-current-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}

.rate-avg {
  font-size: 23rpx;
  color: #7c3aed;
  font-weight: 600;
  margin-top: 12rpx;
}

/* ========== 今日班次 ========== */
.shift-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.shift-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.shift-time {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #8B1A1A;
}

.shift-body {
  flex: 1;
  min-width: 0;
}

.shift-main {
  font-size: 27rpx;
  font-weight: 600;
  color: #111827;
}

.shift-note {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pill.completed {
  background: #dcfce7;
  color: #166534;
}

.pill.in_progress {
  background: #fef3c7;
  color: #92400e;
}

.pill.pending {
  background: #fee2e2;
  color: #8B1A1A;
}

/* ========== 打卡操作 ========== */
.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.action-grid .btn {
  font-size: 29rpx;
  letter-spacing: 1rpx;
}

.extra-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.extra-actions .btn {
  font-size: 26rpx;
  font-weight: 600;
}

.extra-tip {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

/* ========== 弹层 ========== */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-box {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.18);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7f1d1d;
  margin-bottom: 10rpx;
}

.modal-tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 8rpx;
}
