<view class="page">
  <view class="card">
    <view class="title">我的班次</view>
    <view class="subtitle">显示当前已确认排班周期内的实际班次</view>
  </view>

  <view class="card">
    <block wx:if="{{shifts.length}}">
      <view class="list-item" wx:for="{{shifts}}" wx:key="key">
        <view class="row">
          <view>
            <view class="shift-date">{{item.date}} {{item.day}}</view>
            <view class="muted">{{item.slotLabel}}</view>
          </view>
          <view class="pill">{{item.slotId}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无已确认班次</view>
  </view>

  <view class="card">
    <view class="section-title">候补与申请</view>
    <view class="muted">候补、换班和代班申请会在“换代班”页集中处理。</view>
  </view>
</view>
