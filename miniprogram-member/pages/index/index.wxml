<view class="page">
  <!-- 顶部 Hero -->
  <view class="hero-card">
    <view class="hero-dot hero-dot-1"></view>
    <view class="hero-dot hero-dot-2"></view>
    <view class="hero-main">
      <view class="hero-name">{{userName || '成员'}}</view>
      <view class="hero-date">{{todayText}}</view>
    </view>
    <view class="hero-tag">学工办助理</view>
  </view>

  <!-- 数据概览 -->
  <view class="stat-grid">
    <view class="stat-cell stat-shift">
      <view class="stat-label">本月值班</view>
      <view class="stat-value">{{monthly.shiftCount}}<text class="stat-unit">次</text></view>
      <view class="stat-sub">含补报</view>
    </view>
    <view class="stat-cell stat-hours">
      <view class="stat-label">总工时</view>
      <view class="stat-value">{{monthly.totalHours}}<text class="stat-unit">h</text></view>
      <view class="stat-sub">{{monthly.year}}年{{monthly.month}}月</view>
    </view>
    <view class="stat-cell stat-pay">
      <view class="stat-label">预计薪酬</view>
      <view class="stat-value">{{monthly.totalPay}}<text class="stat-unit">元</text></view>
      <view class="stat-sub">25 元/小时</view>
    </view>
    <view class="stat-cell stat-rate">
      <view class="stat-label">班次评价</view>
      <view class="stat-value stat-emoji">{{myEmoji}}</view>
      <view class="stat-sub">忙碌程度 · {{myLabel}}</view>
    </view>
  </view>

  <!-- 班次评价 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title"><view class="card-bar"></view>班次评价</view>
      <view class="rate-reset" wx:if="{{ratingTarget && myStars}}" bindtap="reRate">重评</view>
    </view>
    <view class="card-desc">给这一班的忙碌程度打个分，帮大家下次选班时做参考</view>
    <block wx:if="{{ratingTarget}}">
      <view class="emoji-picker">
        <view
          class="emoji-item {{lv.value === myStars ? 'on' : ''}}"
          wx:for="{{busyLevels}}"
          wx:for-item="lv"
          wx:key="value"
          data-stars="{{lv.value}}"
          bindtap="pickStar">
          <text class="emoji-face">{{lv.emoji}}</text>
          <text class="emoji-text">{{lv.label}}</text>
        </view>
      </view>
      <view class="rate-current">
        <text class="rate-current-emoji">{{myEmoji}}</text>
        <text class="rate-current-text">{{ratingTarget.day}} {{ratingTarget.slotLabel}} · {{myLabel}}</text>
      </view>
      <view class="rate-avg" wx:if="{{slotAvg}}">该时段平均 {{avgEmoji}} {{slotAvg}} · {{slotCount}} 人评价</view>
      <view class="rate-avg" wx:else>该时段还没有人评价</view>
    </block>
    <view wx:else class="empty">暂无可评价班次</view>
  </view>

  <!-- 今日班次 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title"><view class="card-bar"></view>今日班次</view>
      <view class="card-meta">{{todayText}}</view>
    </view>
    <block wx:if="{{todayShifts.length}}">
      <view class="shift-row" wx:for="{{todayShifts}}" wx:key="key">
        <view class="shift-time">{{item.slotLabel}}</view>
        <view class="shift-body">
          <view class="shift-main">{{item.day}}值班</view>
          <view class="shift-note">{{item.date || '当前周期'}}</view>
        </view>
        <view class="pill {{item.status}}">{{item.statusText}}</view>
      </view>
    </block>
    <view wx:else class="empty">今天暂无排班</view>
  </view>

  <!-- 打卡操作 -->
  <view class="card">
    <view class="card-head">
      <view class="card-title"><view class="card-bar"></view>值班打卡</view>
    </view>
    <view class="action-grid">
      <button class="btn btn-main" loading="{{checkingIn}}" bindtap="checkin">上班签到</button>
      <button class="btn btn-second" loading="{{checkingOut}}" bindtap="checkout">下班签退</button>
    </view>
    <view class="extra-actions">
      <button class="btn btn-ghost" bindtap="openSuppForm">补签退</button>
      <button class="btn btn-ghost" bindtap="openOtForm">工作补报</button>
    </view>
    <view class="extra-tip">忘记签退？用「补签退」补上实际离开的时间，提交后由管理员审核</view>
  </view>

  <!-- 补签退申请 -->
  <view class="modal-mask" wx:if="{{suppVisible}}" bindtap="closeSuppForm">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">申请补签退</view>
      <view class="modal-tip">忘记签退时，填写实际离开的时间，提交后等待管理员审核。</view>
      <view class="field">
        <view class="label">签到日期</view>
        <picker mode="date" value="{{suppDate}}" bindchange="onSuppDateChange">
          <view class="picker">{{suppDate}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">补签退时间</view>
        <picker mode="time" value="{{suppTime}}" bindchange="onSuppTimeChange">
          <view class="picker">{{suppTime}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">备注说明</view>
        <input class="input" value="{{suppReason}}" bindinput="onSuppReasonInput" placeholder="如：忘记打卡、系统故障等..." placeholder-class="input-placeholder" />
      </view>
      <view class="modal-actions">
        <button class="btn btn-second" bindtap="closeSuppForm">取消</button>
        <button class="btn btn-main" loading="{{submittingSupp}}" bindtap="submitSupp">提交申请</button>
      </view>
    </view>
  </view>

  <!-- 工作补报 -->
  <view class="modal-mask" wx:if="{{otVisible}}" bindtap="closeOtForm">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">工作补报</view>
      <view class="modal-tip">上报老师额外安排的不在值班表里的工作时间，提交后由管理员审核。</view>
      <view class="field">
        <view class="label">日期</view>
        <picker mode="date" value="{{otDate}}" bindchange="onOtDateChange">
          <view class="picker">{{otDate}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">时长（小时）</view>
        <input class="input" type="digit" value="{{otHours}}" bindinput="onOtHoursInput" placeholder="如：2" placeholder-class="input-placeholder" />
      </view>
      <view class="field">
        <view class="label">工作内容</view>
        <textarea class="textarea" value="{{otContent}}" bindinput="onOtContentInput" placeholder="简要描述工作内容..." placeholder-class="textarea-placeholder"></textarea>
      </view>
      <view class="modal-actions">
        <button class="btn btn-second" bindtap="closeOtForm">取消</button>
        <button class="btn btn-main" loading="{{submittingOt}}" bindtap="submitOt">提交申请</button>
      </view>
    </view>
  </view>
</view>
