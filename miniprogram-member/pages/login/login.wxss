.login-page {
  min-height: 100vh;
  padding: 100rpx 34rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff 0%, #f2f4f7 100%);
}

.brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 44rpx;
}

.brand-mark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #7f1d1d, #a3322e);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 40rpx;
  box-shadow: 0 10rpx 24rpx rgba(139, 26, 26, 0.2);
}

.brand .title {
  font-size: 38rpx;
}

.login-btn {
  margin-top: 20rpx;
  letter-spacing: 4rpx;
}
