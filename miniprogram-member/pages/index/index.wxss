.hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.shift-main {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.notice {
  margin: 16rpx 0 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.notice.holiday {
  background: #ecfdf5;
  color: #047857;
}

.notice.makeup {
  background: #fff7ed;
  color: #9a3412;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.pill.completed {
  background: #dcfce7;
  color: #166534;
}

.pill.in_progress {
  background: #fef3c7;
  color: #92400e;
}

.pill.pending {
  background: #fee2e2;
  color: #8B1A1A;
}
