<view class="page">
  <view class="card">
    <view class="title">订阅提醒</view>
    <view class="subtitle">微信订阅消息需要成员主动授权</view>
  </view>

  <view class="card">
    <view class="list-item row">
      <view>
        <view class="item-title">签到提醒</view>
        <view class="muted">成员忘记签到时发送提醒</view>
      </view>
      <switch checked="{{settings.missedCheckin}}" data-key="missedCheckin" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">签退提醒</view>
        <view class="muted">成员忘记签退时发送提醒</view>
      </view>
      <switch checked="{{settings.missedCheckout}}" data-key="missedCheckout" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">换班申请提醒</view>
        <view class="muted">有换班申请发出时发送提醒</view>
      </view>
      <switch checked="{{settings.shiftSwap}}" data-key="shiftSwap" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">替班通知</view>
        <view class="muted">有替班申请发出时发送提醒</view>
      </view>
      <switch checked="{{settings.shiftSubstitute}}" data-key="shiftSubstitute" bindchange="onSwitch" />
    </view>
  </view>

  <view class="card">
    <button class="btn" loading="{{saving}}" bindtap="save">保存设置</button>
    <button class="btn secondary subscribe-btn" data-key="missedCheckin" loading="{{requestingKey === 'missedCheckin'}}" bindtap="requestOneSubscribe">授权签到提醒</button>
    <button class="btn secondary subscribe-btn" data-key="missedCheckout" loading="{{requestingKey === 'missedCheckout'}}" bindtap="requestOneSubscribe">授权签退提醒</button>
    <button class="btn secondary subscribe-btn" data-key="shiftSwap" loading="{{requestingKey === 'shiftSwap'}}" bindtap="requestOneSubscribe">授权换班申请提醒</button>
    <button class="btn secondary subscribe-btn" data-key="shiftSubstitute" loading="{{requestingKey === 'shiftSubstitute'}}" bindtap="requestOneSubscribe">授权替班通知</button>
    <view class="muted note">微信订阅消息需要成员主动授权。请逐项授权需要的提醒，授权后系统会保存你的提醒偏好。</view>
  </view>
</view>
