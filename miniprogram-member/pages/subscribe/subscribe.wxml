<view class="page">
  <view class="card">
    <view class="title">订阅提醒</view>
    <view class="subtitle">微信订阅消息需要成员主动授权</view>
  </view>

  <view class="card">
    <view class="list-item row">
      <view>
        <view class="item-title">签到提醒</view>
        <view class="muted">成员忘记签到时发送提醒</view>
      </view>
      <switch checked="{{settings.missedCheckin}}" data-key="missedCheckin" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">签退提醒</view>
        <view class="muted">成员忘记签退时发送提醒</view>
      </view>
      <switch checked="{{settings.missedCheckout}}" data-key="missedCheckout" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">换班申请提醒</view>
        <view class="muted">有换班申请发出时发送提醒</view>
      </view>
      <switch checked="{{settings.shiftSwap}}" data-key="shiftSwap" bindchange="onSwitch" />
    </view>
    <view class="list-item row">
      <view>
        <view class="item-title">替班通知</view>
        <view class="muted">有替班申请发出时发送提醒</view>
      </view>
      <switch checked="{{settings.shiftSubstitute}}" data-key="shiftSubstitute" bindchange="onSwitch" />
    </view>
  </view>

  <view class="card">
    <button class="btn" loading="{{saving}}" bindtap="save">保存设置</button>
    <button class="btn secondary subscribe-btn" loading="{{subscribing}}" bindtap="requestAllSubscribe">开启消息订阅</button>
    <view class="muted note">微信订阅消息需要成员主动授权。系统会按上方开关请求授权，并保存你的提醒偏好。</view>
  </view>
</view>
