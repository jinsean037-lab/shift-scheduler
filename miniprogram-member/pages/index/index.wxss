/* ========== 数据概览四宫格 ========== */
.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.stat-cell {
  background: #fff;
  border-radius: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  box-sizing: border-box;
  min-height: 190rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.stat-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.stat-value {
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #111827;
}

.stat-unit {
  font-size: 24rpx;
  font-weight: 600;
  color: #6b7280;
  margin-left: 6rpx;
}

.stat-sub {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 10rpx;
}

.stat-shift {
  border-top: 6rpx solid #8B1A1A;
}

.stat-shift .stat-value {
  color: #8B1A1A;
}

.stat-hours {
  border-top: 6rpx solid #2563eb;
}

.stat-hours .stat-value {
  color: #2563eb;
}

.stat-pay {
  border-top: 6rpx solid #d97706;
}

.stat-pay .stat-value {
  color: #d97706;
}

.stat-rate {
  border-top: 6rpx solid #7c3aed;
}

.stat-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

/* ========== 班次评价 ========== */
.rate-reset {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border: 1rpx solid #ddd6fe;
  border-radius: 999rpx;
  background: #f5f3ff;
  color: #7c3aed;
  font-size: 22rpx;
  font-weight: 600;
}

.pig-picker {
  display: flex;
  gap: 8rpx;
  margin-bottom: 18rpx;
}

.pig-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 4rpx 10rpx;
  border-radius: 16rpx;
  border: 1rpx solid #eef0f3;
  background: #fbfbfc;
  box-sizing: border-box;
}

.pig-item.on {
  background: #fff7ed;
  border-color: #fdba74;
  box-shadow: 0 8rpx 18rpx rgba(217, 119, 6, 0.14);
}

.pig-img {
  width: 76rpx;
  height: 76rpx;
  opacity: 0.5;
  transition: transform 0.2s ease;
}

.pig-item.on .pig-img {
  opacity: 1;
  transform: scale(1.12);
}

.pig-text {
  font-size: 19rpx;
  color: #9ca3af;
  white-space: nowrap;
}

.pig-item.on .pig-text {
  color: #b45309;
  font-weight: 700;
}

.rate-current {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f9fafb;
  border: 1rpx solid #eef0f3;
}

.rate-current-img {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
}

.rate-current-text {
  font-size: 26rpx;
  color: #374151;
  font-weight: 600;
}

.rate-avg {
  font-size: 23rpx;
  color: #7c3aed;
  font-weight: 600;
  margin-top: 12rpx;
}

/* ========== 今日班次 ========== */
.shift-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.shift-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.shift-time {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #8B1A1A;
}

.shift-body {
  flex: 1;
  min-width: 0;
}

.shift-main {
  font-size: 27rpx;
  font-weight: 600;
  color: #111827;
}

.shift-note {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.pill.completed {
  background: #dcfce7;
  color: #166534;
}

.pill.in_progress {
  background: #fef3c7;
  color: #92400e;
}

.pill.pending {
  background: #fee2e2;
  color: #8B1A1A;
}

/* ========== 打卡操作 ========== */
/* v8.0 签到 / 签退 合并大圆钮 */
.round-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 28rpx;
}

.round-btn {
  width: 268rpx;
  height: 268rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  background: linear-gradient(165deg, #FFC6D1 0%, #FF93A8 55%, #F57C95 100%);
  box-shadow: 0 14rpx 30rpx rgba(244, 114, 140, 0.32), inset 0 -8rpx 0 rgba(190, 60, 90, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.12s ease;
}

.round-btn:active {
  transform: scale(0.95);
}

.round-btn.in_progress {
  background: linear-gradient(165deg, #C9F0E2 0%, #82D2B6 55%, #51BA9B 100%);
  box-shadow: 0 14rpx 30rpx rgba(79, 185, 154, 0.32), inset 0 -8rpx 0 rgba(30, 120, 95, 0.12);
}

.round-btn.completed {
  background: linear-gradient(165deg, #EDEFF2 0%, #CBD2D9 100%);
  box-shadow: 0 8rpx 18rpx rgba(120, 130, 140, 0.2);
  opacity: 0.9;
}

.round-btn.none {
  background: linear-gradient(165deg, #F2F4F6 0%, #DCE1E6 100%);
  opacity: 0.7;
}

.round-img {
  width: 212rpx;
  height: 212rpx;
}

.round-loading {
  position: absolute;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  border: 7rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #FFFFFF;
  animation: roundSpin 0.9s linear infinite;
}

@keyframes roundSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.round-hint {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #8a9099;
  letter-spacing: 1rpx;
}

.extra-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.extra-actions .btn {
  font-size: 26rpx;
  font-weight: 600;
}

.extra-tip {
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

/* ========== 弹层 ========== */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-box {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.18);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #7f1d1d;
  margin-bottom: 10rpx;
}

.modal-tip {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-bottom: 26rpx;
}

.modal-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 8rpx;
}

/* ========== 签到 / 签退成功庆祝 ========== */
.celebrate {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.96);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.confetti-layer {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 100vh;
  overflow: hidden;
}

.cf {
  position: absolute;
  top: -40rpx;
  width: 14rpx;
  height: 22rpx;
  border-radius: 4rpx;
  opacity: 0.95;
  animation-name: cfFall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes cfFall {
  0% { transform: translateY(-60rpx) rotate(0deg); opacity: 1; }
  100% { transform: translateY(102vh) rotate(720deg); opacity: 0.15; }
}

.celebrate-box {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: popIn 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
}

@keyframes popIn {
  0% { transform: scale(0.5); opacity: 0; }
  60% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.celebrate-pig {
  width: 220rpx;
  height: 220rpx;
}

.celebrate-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #8B1A1A;
  letter-spacing: 2rpx;
}

.celebrate-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.6;
}

/* ========== 工时与薪酬合并卡 ========== */
.stat-value-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.stat-value-row .stat-value {
  font-size: 40rpx;
}

.stat-hours {
  color: #2563eb;
}

.stat-pay-v {
  color: #d97706;
}

.stat-sep {
  width: 1rpx;
  height: 42rpx;
  background: #e5e7eb;
}
