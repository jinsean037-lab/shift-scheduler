<view class="page">
  <view class="card hero">
    <view>
      <view class="title">{{userName || '成员'}}</view>
      <view class="subtitle">{{todayText}}</view>
    </view>
    <view class="pill">成员端</view>
  </view>

  <!-- v7.3 月度统计 + 班次评价 四宫格 -->
  <view class="stat-grid">
    <view class="stat-cell stat-shift">
      <view class="stat-label">本月值班</view>
      <view class="stat-value">{{monthly.shiftCount}}<text class="stat-unit">次</text></view>
      <view class="stat-sub">含补报</view>
    </view>
    <view class="stat-cell stat-hours">
      <view class="stat-label">总工时</view>
      <view class="stat-value">{{monthly.totalHours}}<text class="stat-unit">h</text></view>
      <view class="stat-sub">{{monthly.year}}年{{monthly.month}}月</view>
    </view>
    <view class="stat-cell stat-pay">
      <view class="stat-label">预计薪酬</view>
      <view class="stat-value">{{monthly.totalPay}}<text class="stat-unit">元</text></view>
      <view class="stat-sub">25 元/小时</view>
    </view>
    <view class="stat-cell stat-rate">
      <view class="stat-rate-head">
        <view class="stat-label">班次评价（忙碌程度）</view>
        <view class="rate-reset" wx:if="{{ratingTarget && myStars}}" bindtap="reRate">重评</view>
      </view>
      <view class="emojis" wx:if="{{ratingTarget}}">
        <text
          class="emoji {{item.value === myStars ? 'on' : ''}}"
          wx:for="{{busyLevels}}"
          wx:key="value"
          data-stars="{{item.value}}"
          bindtap="pickStar">{{item.emoji}}</text>
      </view>
      <view class="stat-value stat-rate-num" wx:if="{{ratingTarget}}">{{myEmoji}}<text class="stat-unit">{{myLabel}}</text></view>
      <view class="stat-sub" wx:if="{{ratingTarget}}">
        {{ratingTarget.day}} {{ratingTarget.slotLabel}}
      </view>
      <view class="stat-sub stat-rate-avg" wx:if="{{ratingTarget && slotAvg}}">
        平均 {{avgEmoji}} {{slotAvg}} · {{slotCount}} 人评
      </view>
      <view class="stat-sub" wx:elif="{{ratingTarget}}">尚未有人评价该时段</view>
      <view class="stat-sub" wx:else>暂无可评价班次</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">今日班次</view>
    <block wx:if="{{todayShifts.length}}">
      <view class="list-item" wx:for="{{todayShifts}}" wx:key="key">
        <view class="row">
          <view>
            <view class="shift-main">{{item.day}} {{item.slotLabel}}</view>
            <view class="muted">{{item.date || '当前周期'}}</view>
          </view>
          <view class="pill {{item.status}}">{{item.statusText}}</view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">今天暂无排班</view>
  </view>

  <view class="action-grid">
    <button class="btn" loading="{{checkingIn}}" bindtap="checkin">签到</button>
    <button class="btn secondary" loading="{{checkingOut}}" bindtap="checkout">签退</button>
  </view>

  <view class="extra-actions">
    <button class="btn ghost" bindtap="openSuppForm">补签退</button>
    <button class="btn ghost" bindtap="openOtForm">工作补报</button>
  </view>
  <view class="extra-tip">忘记签退？用「补签退」补上实际离开时间，提交后由管理员审核。</view>

  <!-- v7.6 补签退申请 -->
  <view class="modal-mask" wx:if="{{suppVisible}}" bindtap="closeSuppForm">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">申请补签退</view>
      <view class="modal-tip">忘记签退时，填写实际离开的时间，提交后等待管理员审核。</view>
      <view class="field">
        <view class="label">签到日期</view>
        <picker mode="date" value="{{suppDate}}" bindchange="onSuppDateChange">
          <view class="picker">{{suppDate}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">补签退时间</view>
        <picker mode="time" value="{{suppTime}}" bindchange="onSuppTimeChange">
          <view class="picker">{{suppTime}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">备注说明</view>
        <input class="input" value="{{suppReason}}" bindinput="onSuppReasonInput" placeholder="如：忘记打卡、系统故障等..." placeholder-class="input-placeholder" />
      </view>
      <view class="modal-actions">
        <button class="btn secondary" bindtap="closeSuppForm">取消</button>
        <button class="btn" loading="{{submittingSupp}}" bindtap="submitSupp">提交申请</button>
      </view>
    </view>
  </view>

  <!-- v7.6 工作补报 -->
  <view class="modal-mask" wx:if="{{otVisible}}" bindtap="closeOtForm">
    <view class="modal-box" catchtap="noop">
      <view class="modal-title">工作补报</view>
      <view class="modal-tip">上报老师额外安排的不在值班表里的工作时间，提交后由管理员审核。</view>
      <view class="field">
        <view class="label">日期</view>
        <picker mode="date" value="{{otDate}}" bindchange="onOtDateChange">
          <view class="picker">{{otDate}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">时长（小时）</view>
        <input class="input" type="digit" value="{{otHours}}" bindinput="onOtHoursInput" placeholder="如：2" placeholder-class="input-placeholder" />
      </view>
      <view class="field">
        <view class="label">工作内容</view>
        <textarea class="textarea" value="{{otContent}}" bindinput="onOtContentInput" placeholder="简要描述工作内容..." placeholder-class="textarea-placeholder"></textarea>
      </view>
      <view class="modal-actions">
        <button class="btn secondary" bindtap="closeOtForm">取消</button>
        <button class="btn" loading="{{submittingOt}}" bindtap="submitOt">提交申请</button>
      </view>
    </view>
  </view>
</view>
