.shifts-page {
  padding: 18rpx;
}

.header-card {
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}

.week-board {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.day-panel {
  background: #fff;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
  border-left: 6rpx solid transparent;
}

.day-panel.today {
  border-left-color: #8B1A1A;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.day-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.day-date {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.today-tag {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #8B1A1A;
  font-size: 20rpx;
  font-weight: 700;
}

.slot-line {
  display: grid;
  grid-template-columns: 150rpx 1fr;
  gap: 12rpx;
  padding: 5rpx 0;
  align-items: start;
}

.slot-time {
  font-size: 22rpx;
  line-height: 1.3;
  color: #8B1A1A;
  font-weight: 700;
}

.slot-members {
  font-size: 24rpx;
  line-height: 1.3;
  color: #111827;
  word-break: break-all;
}

.slot-empty {
  padding: 4rpx 0;
  color: #9ca3af;
  font-size: 24rpx;
}

.mine-card {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.mine-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.mine-date {
  font-size: 24rpx;
  color: #111827;
  font-weight: 700;
}

.mine-slot {
  max-width: 360rpx;
  text-align: right;
  color: #6b7280;
  font-size: 24rpx;
}

.compact-empty {
  padding: 16rpx 0 4rpx;
}
