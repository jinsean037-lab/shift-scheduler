page {
  background: #f2f4f7;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* ========== 卡片 ========== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

/* ========== 卡片标题（左侧金色竖条） ========== */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
}

.card-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #8B1A1A, #C4A35A);
}

.card-title-note {
  font-size: 24rpx;
  font-weight: 500;
  color: #9ca3af;
}

.card-meta {
  font-size: 24rpx;
  color: #9ca3af;
}

.card-desc {
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

/* ========== 顶部 Hero ========== */
.hero-card {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #7f1d1d 0%, #8B1A1A 55%, #a3322e 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 10rpx 28rpx rgba(139, 26, 26, 0.18);
}

.hero-main {
  position: relative;
  flex: 1;
  min-width: 0;
}

.hero-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.hero-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  margin-top: 8rpx;
}

.hero-tag {
  position: relative;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #f7e7c8;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  white-space: nowrap;
}

.hero-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero-dot-1 {
  width: 220rpx;
  height: 220rpx;
  right: -70rpx;
  top: -90rpx;
}

.hero-dot-2 {
  width: 140rpx;
  height: 140rpx;
  right: 110rpx;
  bottom: -80rpx;
}

/* ========== 页面级标题 ========== */
.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #7f1d1d;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 25rpx;
  color: #6b7280;
  line-height: 1.5;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  color: #111827;
}

.muted {
  font-size: 25rpx;
  color: #9ca3af;
}

/* ========== 按钮 ========== */
.btn {
  border-radius: 14rpx;
  border: 0;
  background: #8B1A1A;
  color: #fff;
  font-weight: 700;
  font-size: 28rpx;
}

.btn.secondary {
  background: #374151;
}

.btn.ghost {
  background: #f3f4f6;
  color: #374151;
}

.btn.warn {
  background: #b45309;
}

.btn-main {
  background: linear-gradient(135deg, #8B1A1A, #a8322f);
}

.btn-second {
  background: linear-gradient(135deg, #334155, #556070);
}

.btn-ghost {
  background: #f7f8fa;
  color: #4b5563;
  border: 1rpx solid #e5e7eb;
  font-weight: 600;
}

/* ========== 表单 ========== */
.input,
.textarea,
.picker {
  background: #fff;
  border: 1rpx solid #d1d5db;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.input,
.picker {
  min-height: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.55;
  padding: 22rpx 24rpx;
}

.input-placeholder {
  color: #9ca3af;
  font-size: 26rpx;
}

.textarea-placeholder {
  color: #9ca3af;
  font-size: 26rpx;
}

.field {
  margin-bottom: 22rpx;
}

.label {
  color: #374151;
  font-size: 25rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

/* ========== 状态标签 ========== */
.pill {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #8B1A1A;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

/* ========== 列表 & 空状态 ========== */
.list-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.list-item:last-child {
  border-bottom: 0;
}

.empty {
  text-align: center;
  padding: 48rpx 20rpx;
  color: #9ca3af;
  font-size: 27rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}
