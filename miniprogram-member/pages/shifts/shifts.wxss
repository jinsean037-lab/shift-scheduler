.shifts-page {
  padding-top: 24rpx;
}

/* ========== 周概览 ========== */
.week-summary {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #7f1d1d 0%, #8B1A1A 55%, #a3322e 100%);
  border-radius: 20rpx;
  padding: 30rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(139, 26, 26, 0.18);
}

.ws-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.ws-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.ws-range {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 8rpx;
}

.ws-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.ws-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  padding: 18rpx 8rpx;
}

.ws-item {
  text-align: center;
  border-right: 1rpx solid rgba(255, 255, 255, 0.14);
}

.ws-item:last-child {
  border-right: 0;
}

.ws-val {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
}

.ws-label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.68);
  margin-top: 4rpx;
}

.ws-legend {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

/* ========== 时间轴 ========== */
.timeline {
  background: #fff;
  border-radius: 20rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.tl-day {
  display: flex;
  gap: 24rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.tl-day:last-child {
  border-bottom: 0;
}

.tl-date {
  width: 116rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.tl-weekday {
  font-size: 29rpx;
  font-weight: 800;
  color: #111827;
}

.tl-datestr {
  font-size: 22rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.tl-today {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #8B1A1A;
  font-size: 19rpx;
  font-weight: 700;
}

.tl-day.today .tl-weekday {
  color: #8B1A1A;
}

.tl-body {
  flex: 1;
  min-width: 0;
}

.tl-slot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #f8f9fb;
  border: 1rpx solid #eef0f3;
}

.tl-slot:last-child {
  margin-bottom: 0;
}

.tl-slot-time {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: #334155;
}

.tl-slot-members {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: #111827;
  word-break: break-all;
}

.tl-slot-busy {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: #f1f5f9;
  color: #475569;
}

.tl-empty {
  font-size: 24rpx;
  color: #cbd5e1;
  padding: 14rpx 0;
}

/* 忙碌度分档配色 */
.busy-1 { background: #ecfdf5; color: #047857; }
.busy-2 { background: #e0f2fe; color: #0369a1; }
.busy-3 { background: #f1f5f9; color: #475569; }
.busy-4 { background: #fff7ed; color: #c2410c; }
.busy-5 { background: #fef2f2; color: #b91c1c; }

.ws-badge.busy-1 { background: rgba(16, 185, 129, 0.22); }
.ws-badge.busy-2 { background: rgba(14, 165, 233, 0.22); }
.ws-badge.busy-3 { background: rgba(255, 255, 255, 0.18); }
.ws-badge.busy-4 { background: rgba(249, 115, 22, 0.26); }
.ws-badge.busy-5 { background: rgba(239, 68, 68, 0.3); }

/* ========== 我的班次 ========== */
.mine-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.mine-chip {
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: #fdf7f7;
  border: 1rpx solid #f3e3e3;
}

.mine-chip-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #8B1A1A;
}

.mine-chip-slot {
  font-size: 21rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.ws-pig {
  width: 46rpx;
  height: 46rpx;
}

.tl-busy-pig {
  width: 34rpx;
  height: 34rpx;
  margin-right: 6rpx;
}
